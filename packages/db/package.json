{
  "name": "@fluggi/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -c -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -c -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -c -- prisma migrate reset",
    "seed": "dotenv -e ../../.env -c -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@fluggi/contracts": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
