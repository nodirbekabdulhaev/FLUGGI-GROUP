{
  "name": "@fluggi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "dev:worker": "dotenv -e ../../.env -- nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "dotenv -e ../../.env -- vitest run --project integration --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fluggi/contracts": "workspace:*",
    "@fluggi/db": "workspace:*",
    "@fluggi/domain": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
