# ─── Общие ───
NODE_ENV=development
TZ=Asia/Tashkent

# ─── База данных (PostgreSQL 16) ───
DATABASE_URL=postgresql://fluggi:fluggi@localhost:5432/fluggi?schema=public
# Отдельная БД для интеграционных тестов (будет очищаться!)
TEST_DATABASE_URL=postgresql://fluggi:fluggi@localhost:5432/fluggi_test?schema=public

# ─── API (NestJS) ───
PORT=4000
# Секрет приложения, минимум 32 символа: openssl rand -base64 48
AUTH_SECRET=
# Публичный адрес веб-интерфейса (для проверки Origin и CSRF)
APP_URL=http://localhost:3000
# Срок жизни сессии (дней, скользящий)
SESSION_TTL_DAYS=7
LOG_LEVEL=info
# IP клиента за прокси (Nginx/Docker). Значение express "trust proxy"
TRUST_PROXY=loopback, linklocal, uniquelocal
# false — события (уведомления) обрабатывает только worker; по умолчанию их обрабатывает и API
OUTBOX_IN_API=
# true отключает rate limit — только для тестов!
RATE_LIMIT_DISABLED=false

# ─── Web (Next.js) ───
# Адрес API для серверных запросов Next.js и для прокси /api/*
API_INTERNAL_URL=http://localhost:4000

# ─── Seed ───
# Пароль для всех демо-аккаунтов. Если пусто — генерируется и печатается в консоль.
SEED_DEMO_PASSWORD=
# Создавать демо-данные (по умолчанию true вне production)
SEED_DEMO=
# Первый CEO для production
SEED_CEO_EMAIL=
SEED_CEO_PASSWORD=
SEED_CEO_NAME=

# ─── docker-compose.prod.yml ───
POSTGRES_USER=fluggi
POSTGRES_PASSWORD=
POSTGRES_DB=fluggi

# ─── Telegram-бот (README, раздел 9) ───
# Токен от @BotFather. Пусто — бот выключен, уведомления только в CRM
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (необязательно — берётся через getMe)
TELEGRAM_BOT_USERNAME=
# polling — локально, без домена; webhook — production (нужен HTTPS)
TELEGRAM_MODE=polling
# Секрет webhook (16+ символов: openssl rand -hex 24); обязателен в режиме webhook
TELEGRAM_WEBHOOK_SECRET=
# Прокси, если компьютер/сервер не видит api.telegram.org напрямую: http://host:port или socks5://host:port
TELEGRAM_PROXY_URL=

# Instagram / Facebook / таргет (Meta). Без значений интеграция выключена.
# Секрет приложения: developers.facebook.com → приложение → Настройки → Основное
META_APP_SECRET=
# Любое слово; то же указывается при подключении webhook в кабинете Meta
META_VERIFY_TOKEN=
# Долгосрочный токен страницы Facebook, к которой привязан Instagram
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_BASE=https://graph.facebook.com/v21.0

# ─── Планировщик ───
# false — отключить отчёты, напоминания и проверки по расписанию
SCHEDULER_ENABLED=true

# ─── Файловое хранилище ───
# local — папка на диске (разработка, один сервер); s3 — Beget S3 / MinIO / AWS
STORAGE_DRIVER=local
# Папка для local (по умолчанию ./storage относительно apps/api)
STORAGE_LOCAL_DIR=
STORAGE_ENDPOINT=
STORAGE_REGION=ru-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
